# Copie de ce fichier : /opt/matrix-sync/.env (droits 600, proprietaire matrixsync).
# Ne jamais le mettre dans git.

# API du CRM
MATRIX_API_BASE=https://api.rayharvey.ca
# Meme valeur que MATRIX_SYNC_API_KEY dans l'environnement de l'API (cle propre a ce robot, distincte de Scrapis)
MATRIX_SYNC_API_KEY=

# Compte Matrix : idealement un code d'usager reserve au robot
MATRIX_USER=
MATRIX_PASSWORD=

# Navigateur
CHROME_BIN=/usr/bin/google-chrome
CHROMEDRIVER_PATH=
MATRIX_DATA_DIR=/opt/matrix-sync/data
